{
  "name": "loxley-calendar-qr",
  "version": "0.1.0",
  "private": true,
  "description": "LOXLEY Calendar QR: scan a QR to watch a video, with a small CMS for uploading videos",
  "type": "module",
  "main": "app.js",
  "engines": {
    "node": ">=24.20 <25"
  },
  "scripts": {
    "start": "node app.js",
    "dev": "node --env-file=.env.dev --watch app.js",
    "test": "node --env-file=.env.test --test",
    "migrate": "node scripts/migrate.js",
    "migrate:dev": "node --env-file=.env.dev scripts/migrate.js",
    "video:set": "node scripts/video-set.js",
    "video:set:dev": "node --env-file=.env.dev scripts/video-set.js",
    "admin:create": "node scripts/admin.js create",
    "admin:create:dev": "node --env-file=.env.dev scripts/admin.js create",
    "admin:reset-password": "node scripts/admin.js reset-password",
    "admin:reset-password:dev": "node --env-file=.env.dev scripts/admin.js reset-password",
    "admin:list": "node scripts/admin.js list",
    "admin:list:dev": "node --env-file=.env.dev scripts/admin.js list"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "busboy": "^1.6.0",
    "express": "^5.3.0",
    "express-mysql-session": "^3.0.3",
    "express-session": "^1.19.0",
    "mysql2": "^3.24.6",
    "qrcode": "^1.5.4"
  },
  "overrides": {
    "express-mysql-session": {
      "mysql2": "$mysql2"
    }
  },
  "devDependencies": {
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0"
  }
}
